# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but DO commit the public production config (all NEXT_PUBLIC_, RLS-protected)
# so the GitHub Pages build has Supabase + film URLs.
!.env.production

# guest submissions (RSVPs & messages) — private data, never commit
/data

# large media — hosted externally (Supabase Storage), not committed/deployed
/public/film/*.mp4

# camera originals for the gallery (7000px, 10–27 MB each). Only the web-sized
# exports in /public/gallery ship; regenerate with scripts/optimize-gallery.mjs
/public/images/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
